# External checkpoints - keep only their manifest
checkpoints/*
!checkpoints/README.md

# Environment
.env
*.pem
*.key
.venv
env/
venv/
ENV/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Temporary files
*.tmp
*.temp
.cache/
